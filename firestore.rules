rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para checar se o usuário está logado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função para pegar o perfil do usuário logado e verificar se é admin/master
    function isAdminOrMaster() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'MASTER'];
    }

    function isMaster() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MASTER';
    }

    // Coleção: users (Armazena perfis e access_requests via status PENDING_APPROVAL)
    match /users/{userId} {
      // Leitura: Admins/Masters têm acesso global; usuário comum apenas lê seu próprio registro ou pelo seu próprio email autenticado
      allow read: if isAuthenticated() && (
        isAdminOrMaster() || 
        request.auth.uid == userId || 
        (resource != null && resource.data.email == request.auth.token.email)
      );
      
      // Criação: Admins/Masters ou o próprio usuário (com papel restrito inicial e sem privilégios indevidos)
      allow create: if isAuthenticated() && (
        isAdminOrMaster() || 
        (request.auth.uid == userId && 
         request.resource.data.role == 'CONVIDADO' && 
         request.resource.data.status in ['PENDING_APPROVAL', 'REJECTED_DOMAIN'] &&
         (!request.resource.data.keys().hasAny(['viewerDepartments', 'viewerPages', 'assignedArea']) ||
          (request.resource.data.get('viewerDepartments', []) == [] &&
           request.resource.data.get('viewerPages', []) == [] &&
           request.resource.data.get('assignedArea', null) == null)))
      );
      
      // Atualização: Admins/Masters, ou o próprio usuário (com restrições estritas de não alterar papel/status)
      allow update: if isAuthenticated() && (
        isAdminOrMaster() || 
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'departmentId', 'assignedArea', 'viewerDepartments', 'viewerPages']))
      );

      // Exclusão: Apenas Admins/Masters
      allow delete: if isAuthenticated() && isAdminOrMaster();
    }

    // Coleção: tenants (Armazena os silos departamentais)
    match /tenants/{tenantId} {
      // Leitura: Qualquer usuário autenticado precisa ler para saber qual banco conectar
      allow read: if isAuthenticated();
      // Escrita: Apenas Masters ou Admins do sistema central
      allow write: if isAuthenticated() && isAdminOrMaster();
    }

    // Coleção: roles_permissions (Modelagem de RBAC global)
    match /roles_permissions/{roleId} {
      // Leitura: Todos os usuários para carregar seus limites locais
      allow read: if isAuthenticated();
      // Escrita: Apenas MASTER
      allow write: if isAuthenticated() && isMaster();
    }

    // Coleção: access_requests (Pedidos independentes de acesso ou troca de tenant)
    match /access_requests/{requestId} {
      // Leitura: O próprio solicitante ou Admins
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdminOrMaster());
      // Criação: Usuário autenticado solicitando acesso
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Atualização/Exclusão: Apenas Admins
      allow update, delete: if isAuthenticated() && isAdminOrMaster();
    }

    // Coleção: system_page_mappings (Mapeamento de Páginas e Acessos Cruzados)
    match /system_page_mappings/{mappingId} {
      // Leitura: Todos os usuários autenticados (o front-end e o backend filtram o que será exibido, porém a regra pode ser restrita se necessário)
      allow read: if isAuthenticated();
      // Escrita: Apenas Admins ou Masters
      allow write: if isAuthenticated() && isAdminOrMaster();
    }

    // Coleção: page_feedbacks (Armazena votos das modais de informação)
    match /page_feedbacks/{pageId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdminOrMaster();
      
      match /votes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }


    // Coleção: banners (Imagens e comunicados do sistema)
    match /banners/{bannerId} {
      // Leitura: Pública, para carregar na tela de login
      allow read: if true;
      // Escrita: Admins ou Masters
      allow write: if isAuthenticated() && isAdminOrMaster();
    }

    // Coleções Dinâmicas Mapeadas (Processos fm_*, Observações fo_*, Votações fv_*)
    match /fm_{collection}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /fo_{collection}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /fv_{collection}/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Fallback block para outras coleções (default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
